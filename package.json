{
  "name": "orbit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
  "dev": "concurrently \"npm --prefix server run dev\" \"node client/node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 5173\"",
